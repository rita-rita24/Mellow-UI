{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Mellow UI — Design Tokens",
  "$metadata": {
    "lastUpdated": "2026-05-04",
    "componentCount": 65,
    "architecture": {
      "L1_primitive": "標準",
      "L2_semantic":  "目的",
      "L3_component": "部品"
    },
    "colorModel": {
      "strategy": "hybrid",
      "base": "hex",
      "derivatives": "oklch relative color syntax",
      "fallback": "hex（@supports で分岐）",
      "rules": {
        "light_hover": "calc(l - 0.06)",
        "light_active": "calc(l - 0.12)",
        "dark_hover": "calc(l + 0.06)",
        "dark_active": "calc(l + 0.12)"
      },
      "appliedTo": [
        "--action-primary-hover", "--action-primary-active",
        "--action-cta-hover", "--action-cta-active",
        "--btn-danger-bg-hover", "--text-link-hover"
      ]
    },
    "accessibility": {
      "wcag": "2.1 AA",
      "focusRing": "インタラクティブ要素に 3px リング",
      "reducedMotion": "@media (prefers-reduced-motion: reduce) でアニメーション停止",
      "highContrast": "@media (prefers-contrast: more) で枠線を濃く",
      "forcedColors": "Windows ハイコントラスト対応",
      "themeAutoDetect": "prefers-color-scheme で OS 設定に追従"
    }
  },

  "primitive": {
    "color": {
      "blue": {
        "_role": "主軸ブランドカラー",
        "50":  { "$value": "#EEF3FC" },
        "100": { "$value": "#E3EDFB" },
        "200": { "$value": "#BCD0F4" },
        "300": { "$value": "#7BA3E5" },
        "400": { "$value": "#4D80D6" },
        "500": { "$value": "#1E5FBF" },
        "600": { "$value": "#1A4FA8" },
        "700": { "$value": "#1543A0" },
        "800": { "$value": "#103588" },
        "900": { "$value": "#0C2A6B" }
      },
      "peach": {
        "50":  { "$value": "#FFF1EC" },
        "100": { "$value": "#FFD9CC" },
        "200": { "$value": "#FFBBA3" },
        "300": { "$value": "#FFA081" },
        "400": { "$value": "#FF9472" },
        "500": { "$value": "#F87B57" },
        "600": { "$value": "#DC623F" },
        "700": { "$value": "#B14B2E" },
        "800": { "$value": "#82351F" },
        "900": { "$value": "#561F11" }
      },
      "sunshine": {
        "50":  { "$value": "#FFF8E1" },
        "100": { "$value": "#FFEAA7" },
        "300": { "$value": "#FFD66B" },
        "500": { "$value": "#FFCB47" },
        "700": { "$value": "#C99613" }
      },
      "warm": {
        "0":   { "$value": "#FFFFFF" },
        "25":  { "$value": "#FBFAF8" },
        "50":  { "$value": "#F6F4F1" },
        "100": { "$value": "#ECE9E4" },
        "200": { "$value": "#D8D3CC" },
        "300": { "$value": "#B3ACA3" },
        "400": { "$value": "#75675C" },
        "500": { "$value": "#6B6560" },
        "600": { "$value": "#4D4844" },
        "700": { "$value": "#34302D" },
        "800": { "$value": "#1F1C1A" },
        "900": { "$value": "#100E0D" }
      },
      "success": {
        "50": { "$value": "#E5F5EB" }, "100": { "$value": "#C2E7D0" },
        "500": { "$value": "#5DBB7E" }, "700": { "$value": "#2A7A4A" }
      },
      "warning": {
        "50": { "$value": "#FEF3DC" }, "100": { "$value": "#FCE3AE" },
        "500": { "$value": "#F0A933" }, "700": { "$value": "#875A0A" }
      },
      "error": {
        "50": { "$value": "#FCE7E7" }, "100": { "$value": "#F8C7C7" },
        "500": { "$value": "#E36363" }, "700": { "$value": "#A82A2A" },
        "800": { "$value": "#7A1F1F" }
      }
    },
    "typography": {
      "fontFamily": {
        "display": { "$value": "'Zen Maru Gothic', sans-serif" },
        "body":    { "$value": "'Noto Sans JP', sans-serif" },
        "en":      { "$value": "'DM Sans', sans-serif" },
        "mono":    { "$value": "'JetBrains Mono', monospace" }
      },
      "fontSize": {
        "2xs": { "$value": "10px" }, "xs":  { "$value": "12px" },
        "sm":  { "$value": "14px" }, "base": { "$value": "16px" },
        "md":  { "$value": "18px" }, "lg":  { "$value": "20px" },
        "xl":  { "$value": "24px" }, "2xl": { "$value": "30px" },
        "3xl": { "$value": "38px" }, "4xl": { "$value": "48px" },
        "5xl": { "$value": "60px" }, "6xl": { "$value": "76px" }
      }
    },
    "spacing": {
      "1": "4px", "2": "8px", "3": "12px", "4": "16px",
      "5": "20px", "6": "24px", "8": "32px", "10": "40px",
      "12": "48px", "16": "64px", "20": "80px", "24": "96px", "32": "128px"
    },
    "radius": {
      "none": "0", "xs": "0px", "sm": "2px", "md": "4px",
      "lg": "6px", "xl": "8px", "2xl": "12px", "pill": "9999px"
    },
    "shadow": {
      "xs": "0 1px 2px rgba(45,35,25,0.05)",
      "sm": "0 4px 12px rgba(45,35,25,0.06)",
      "md": "0 8px 24px rgba(45,35,25,0.08)",
      "lg": "0 16px 40px rgba(45,35,25,0.10)",
      "xl": "0 32px 64px rgba(45,35,25,0.14)",
      "2xl": "0 48px 96px rgba(45,35,25,0.18)",
      "glow": "0 8px 32px rgba(248,123,87,0.25)"
    },
    "motion": {
      "duration": { "fast": "180ms", "base": "280ms", "slow": "480ms" },
      "easing": {
        "out":    "cubic-bezier(0.16, 1, 0.3, 1)",
        "in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
        "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
      }
    },
    "zIndex": {
      "hide": -1, "base": 0, "raised": 1, "sticky": 100,
      "dropdown": 200, "overlay": 1000, "modal": 1100,
      "popover": 1200, "tooltip": 1300, "toast": 1400
    }
  },

  "semantic": {
    "background": {
      "canvas":     "{primitive.color.warm.0}",
      "subtle":     "{primitive.color.warm.25}",
      "muted":      "{primitive.color.warm.50}",
      "emphasized": "{primitive.color.warm.100}",
      "brand":      "{primitive.color.blue.50}",
      "warm":       "{primitive.color.peach.50}",
      "inverse":    "{primitive.color.blue.900}",
      "overlay":    "rgba(20, 30, 50, 0.5)"
    },
    "text": {
      "primary":   "{primitive.color.warm.800}",
      "secondary": "{primitive.color.warm.600}",
      "tertiary":  "{primitive.color.warm.400}",
      "disabled":  "{primitive.color.warm.300}",
      "inverse":   "{primitive.color.warm.0}",
      "brand":     "{primitive.color.blue.700}",
      "accent":    "{primitive.color.peach.700}",
      "link":      "{primitive.color.blue.600}"
    },
    "border": {
      "subtle":   "{primitive.color.warm.100}",
      "default":  "{primitive.color.warm.200}",
      "strong":   "{primitive.color.warm.300}",
      "brand":    "{primitive.color.blue.300}",
      "disabled": "{primitive.color.warm.200}"
    },
    "action": {
      "primary":         "{primitive.color.blue.500}",
      "primary-hover":   "{primitive.color.blue.600}",
      "cta":             "{primitive.color.peach.500}",
      "cta-hover":       "{primitive.color.peach.600}",
      "disabled-bg":     "{primitive.color.warm.200}",
      "disabled-text":   "{primitive.color.warm.400}"
    },
    "focusRing": {
      "width": "3px",
      "color": "rgba(45, 143, 181, 0.5)",
      "offset": "2px"
    }
  },

  "component": {
    "button": {
      "_purpose": "クリックで操作を実行する基本部品",
      "_variants": ["cta", "primary", "outline", "ghost", "danger"],
      "_states": ["default", "hover", "active", "disabled", "focus"]
    },
    "iconbutton": {
      "_purpose": "アイコンのみのボタン（aria-label必須）",
      "_states": ["default", "hover", "active", "disabled", "focus"]
    },
    "input": {
      "_purpose": "1行テキスト入力",
      "_states": ["default", "hover", "focus", "disabled", "error"]
    },
    "textarea": { "_purpose": "複数行テキスト入力" },
    "select": { "_purpose": "選択肢からひとつ選ぶドロップダウン" },
    "checkbox": { "_purpose": "複数選択可能なチェックボックス" },
    "radio": { "_purpose": "ひとつだけ選ぶラジオボタン" },
    "switch": { "_purpose": "ON/OFFを切り替えるスイッチ" },
    "slider": { "_purpose": "範囲内で数値を選ぶスライダー" },
    "badge": {
      "_purpose": "ステータス強調",
      "_variants": ["accent", "primary", "highlight", "success", "error", "neutral"]
    },
    "tag": { "_purpose": "削除可能なラベル（タグ管理）" },
    "avatar": {
      "_purpose": "ユーザー画像/イニシャル表示",
      "_sizes": ["sm 32px", "md 48px", "lg 64px", "xl 96px"]
    },
    "tooltip": { "_purpose": "ホバー時の補足説明" },
    "alert": {
      "_purpose": "重要なメッセージの表示",
      "_variants": ["info", "success", "warning", "error"]
    },
    "progress": { "_purpose": "進捗を視覚化" },
    "stepcard": { "_purpose": "ナンバリング付きステップカード" },
    "featurecard": { "_purpose": "メディア+説明型カード" },
    "issuecard": { "_purpose": "アイコン+リスト型カード" },
    "statcard": { "_purpose": "数値・トレンド表示カード" },
    "breadcrumb": { "_purpose": "階層ナビゲーション" },
    "pagination": { "_purpose": "ページ送りナビゲーション" },
    "tabs": { "_purpose": "タブ切替（下線方式）" },
    "modal": { "_purpose": "モーダルダイアログ" },
    "toast": { "_purpose": "短時間表示の通知" },
    "hero": { "_purpose": "メインビューセクション" },
    "table": { "_purpose": "表形式データ表示" },
    "searchbar": { "_purpose": "検索バー（ピル型）" },
    "upload": { "_purpose": "ファイルアップロード（D&D対応）" },
    "datepicker": { "_purpose": "日付選択" },
    "otp": { "_purpose": "ワンタイムパスワード入力" },
    "skeleton": { "_purpose": "ローディング時のプレースホルダ" },
    "empty": { "_purpose": "データなし時の表示" },
    "code": { "_purpose": "コードハイライト表示" },
    "divider": { "_purpose": "区切り線" },
    "metric": { "_purpose": "数値ラベルペア" },
    "stepper": { "_purpose": "多段プロセス進捗" },
    "menu": { "_purpose": "コンテキストメニュー" },
    "accordion": { "_purpose": "折りたたみコンテンツ" },
    "banner": { "_purpose": "サイト上部の通知バナー" },
    "numstep": { "_purpose": "数値増減ステッパー" },
    "toggle": { "_purpose": "セグメント切替（トグルグループ）" },
    "avatarstack": { "_purpose": "アバター重ね表示（参加者一覧など）" },
    "kbd": { "_purpose": "キーボードショートカット表示" },
    "rating": { "_purpose": "星評価（レビュー入力／表示）" },
    "spinner": { "_purpose": "ローディングスピナー" },
    "popover": { "_purpose": "クリック起点の小型オーバーレイ" },
    "card": { "_purpose": "汎用ベースカード" },
    "listitem": { "_purpose": "リスト項目（メディア+テキスト+アクション）" },
    "callout": { "_purpose": "重要情報の囲み枠（ドキュメント中の注意書き等）" },
    "btngroup": { "_purpose": "ボタングループ（連結ボタン）" },
    "statusdot": { "_purpose": "ステータスドット（オンライン状態など）" },
    "chip": { "_purpose": "選択可能なチップ（フィルタ用）" },
    "timeline": { "_purpose": "タイムライン（履歴・進捗）" },
    "loader": { "_purpose": "インラインローダー（バー型）" },
    "statgroup": { "_purpose": "統計値グループ（連結表示）" },
    "dl": { "_purpose": "定義リスト（プロパティ表）" },
    "quote": { "_purpose": "引用ブロック" },
    "aside": { "_purpose": "サイドバー型補足パネル" },
    "bell": { "_purpose": "通知ベル（バッジ付）" },
    "combobox": { "_purpose": "オートコンプリート付きセレクト" },
    "range": { "_purpose": "範囲スライダー（最小/最大）" },
    "vsteps": { "_purpose": "縦型ステッパー（プロセス進捗）" },
    "colorpicker": { "_purpose": "カラーピッカー（プリセット選択）" },
    "timepicker": { "_purpose": "時刻選択ピッカー" },
    "tree": { "_purpose": "ツリービュー（階層構造表示）" }
  }
}
